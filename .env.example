# Backend: Node process, Socket.IO, server-side Chess.js and optional built client.
PORT=3001
HOST=0.0.0.0
# Exact frontend origins, comma-separated; no trailing slash or wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_CLIENT=true
RECONNECT_GRACE_MS=120000
WAITING_ROOM_TTL_MS=900000
FINISHED_ROOM_TTL_MS=900000
ROOM_LIFETIME_MS=86400000
MAX_ROOMS=1000

# Frontend BUILD-TIME option. Leave empty for same-origin production/dev proxy.
# For a separately hosted backend use its public HTTPS origin, then rebuild.
VITE_MULTIPLAYER_URL=
